# Variables de entorno del servidor (Vercel → Settings → Environment Variables)
# Marcar todas como "Sensitive" y entorno "Production". No subir valores reales al repositorio.

# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# D3xD / Gisin3 — token que se configura también en D3xD (Datos de Acceso)
D3XD_API_TOKEN=

# BNC
BNC_BASE_URL=
BNC_CLIENT_GUID=
BNC_MASTER_KEY=
BNC_WEBHOOK_API_KEY=
# Token interno para llamadas servidor a servidor (no se usa en el navegador)
BNC_INTERNAL_TOKEN=
